# Copia este archivo a .env.local y completa con las credenciales que
# imprime `supabase start` (desarrollo local) o el dashboard del proyecto
# Supabase (staging/producción).

# Cliente (expuestas al browser — @supabase/ssr las usa en server y cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — jobs, webhooks y operaciones admin (createServiceRoleClient).
# NUNCA exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Usado por `npm run db:types` (supabase gen types) — no necesario en runtime.
SUPABASE_PROJECT_ID=

# Verificado por app/api/cron/refresh-resumen (Vercel Cron) — ver README.
CRON_SECRET=
